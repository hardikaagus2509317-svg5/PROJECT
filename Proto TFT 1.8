#include <Arduino.h>
#include <Wire.h>
#include <TFT_eSPI.h>
#include <ArduinoJson.h>
#include <math.h>

#define MONITOR_BAUD      115200
#define ECU_BAUD          57600
#define SIMULATE          false
#define KEEP_ALIVE_MS     6000
#define ECU_TIMEOUT_MS    3000
#define ECU_RETRY_MS      2000
#define SEND_INTERVAL     500
#define TFT_INTERVAL      500

#define VSS_DEBOUNCE_DELAY  0.3

// ========== LIMIT RPM ==========
#define RPM_MAX           5500

// ========== Palet Warna Tema RACING / F1 ==========
#define C_BLACK     0x0000
#define C_WHITE     0xFFFF
#define C_RACE_RED  0xF800
#define C_GREEN     0x07E0
#define C_YELLOW    0xFFE0
#define C_RED       0xF800
#define C_GRAY      0x39C7
#define C_PANEL     0x10A2
#define C_PANEL2    0x0841
#define C_HILITE    0x9E9F

// ========== Ukuran layar 1.8" ST7735 landscape ==========
#define SCREEN_W    160
#define SCREEN_H    128
#define SIDEBAR_X   124
#define SIDEBAR_W   (SCREEN_W - SIDEBAR_X)

// ========== PIN ==========
const int IRSensorPin   = PB8;
const int ThermistorPin = PA6;
const int sensorAFR     = PA1;

// ========== Serial ==========
HardwareSerial ecuSerial(PA3, PA2);
HardwareSerial SerialESP(PA10, PA9);

// ========== TFT ==========
TFT_eSPI tft = TFT_eSPI();

// ========== Konstanta ==========
const float R1 = 9400.0;
const float c1 = 1.009249522e-03;
const float c2 = 2.378405444e-04;
const float c3 = 2.019202697e-07;

// ========== KONSTANTA VSS PROTO KODE 1 ==========
const double kkbanspd = 0.00039878;
int raw_RPM_VSS = 0;

// ========== Global ==========
int   g_rpm  = 0;
float g_tps  = 0.0;
float g_vbat = 0.0;
int   g_kecepatan = 0;
float g_afr  = 0.0;
int   g_suhu = 0;

String currentLine = "";
bool ecuConnected = false;
unsigned long lastEcuData = 0;
unsigned long lastPing = 0;

// ========== VSS (speed asli) ==========
int inputStateVSS = LOW;
int lastInputStateVSS = LOW;
unsigned long lastDebounceTimeVSS = 0;
unsigned long endTimeVSS = 0;
unsigned long startTimeVSS = 0;

// ========== Buffer suhu ==========
float suhuBuffer[10] = {0};
int bufferIndex = 0;
int bufferFilled = 0;

// ========== Timing ==========
unsigned long lastSend = 0;
unsigned long lastTFTUpdate = 0;
unsigned long packetCounter = 0;
unsigned long startTime = 0;
int lastMinutes = -1;
int lastSeconds = -1;

// ========== State tracker khusus TFT ==========
int   lastSpeedDraw = -1;
int   lastRpmDraw    = -1;
int   lastTpsDraw    = -1;
int   lastSuhuDraw   = -999;
bool  lastEcuStateDraw = true;

// ========== Simulasi khusus suhu (naik turun bertahap agar mudah diamati) ==========
int   simSuhuArah = 1;

// =====================================================
// TFT - HELPER VISUAL
// =====================================================

uint16_t getBarColor(int x) {
  if (x < 50) return C_GREEN;
  if (x < 95) return C_YELLOW;
  return C_RED;
}

// Garis motif "checkered flag" - ciri khas balap
void drawCheckerLine(int x, int y, int w, int size, uint16_t colorA, uint16_t colorB) {
  int n = w / size;
  for (int i = 0; i < n; i++) {
    uint16_t c = (i % 2 == 0) ? colorA : colorB;
    tft.fillRect(x + i * size, y, size, size, c);
  }
}

// =====================================================
// TFT - LAYOUT STATIS
