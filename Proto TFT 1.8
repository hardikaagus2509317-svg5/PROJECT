  tft.setTextColor(C_GRAY, C_PANEL2);
  tft.setTextSize(1);
  tft.setCursor(7, 17);
  tft.print("RPM");

  tft.fillRoundRect(4, 45, 92, 40, 5, C_PANEL);
  tft.drawRoundRect(4, 45, 92, 40, 5, C_RACE_RED);
  tft.setTextColor(C_GRAY, C_PANEL);
  tft.setCursor(8, 47);
  tft.print("SPEED");
  tft.setTextColor(C_RACE_RED, C_PANEL);
  tft.setCursor(68, 76);
  tft.print("KM/H");

  tft.fillRoundRect(4, 87, 116, 36, 4, C_PANEL);
  tft.drawRoundRect(4, 87, 116, 36, 4, C_RACE_RED);
  tft.setTextColor(C_WHITE, C_PANEL);
  tft.setCursor(8, 90);
  tft.print("THROTTLE");

  tft.fillRoundRect(SIDEBAR_X, 15, SIDEBAR_W - 2, 108, 4, C_PANEL);
  tft.drawRoundRect(SIDEBAR_X, 15, SIDEBAR_W - 2, 108, 4, C_RACE_RED);
